# EstiSeries backend — copy this file to .env and fill in values.
# The real .env is gitignored and must never be committed.
#
# YOUCAM_API_KEY is required for scans. Without it the store endpoints
# still work but /health reports unconfigured and scans are refused.
YOUCAM_API_KEY=<redacted>
#
# Optional. HTTP port (defaults to 8787 if unset).
PORT=8787
#
# Accounts (v2.2) — verification + password-recovery email.
# MAIL_FROM is the sender for those emails; PUBLIC_BASE_URL is where the
# /verify and /reset links point.
MAIL_FROM=no-reply@estiseries.ignisalgos.com
PUBLIC_BASE_URL=https://estiseries.ignisalgos.com
# SMTP transport (used when SMTP_HOST is set):
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# MAIL_TRANSPORT forces a transport: smtp | sendmail | capture.
# capture appends messages as JSON lines to MAIL_CAPTURE_PATH (tests).
MAIL_TRANSPORT=
MAIL_CAPTURE_PATH=
